# ---------------------------------------------------------------------------
# Local development: copy this file to .env and leave the defaults alone.
# Production: see the "Deployment" section of the README.
# ---------------------------------------------------------------------------

# Database. A "file:" URL uses SQLite (local development).
# A "postgres://" URL automatically switches the app to Postgres (production).
DATABASE_URL=file:./a2s.db

# Long random string used to sign login sessions.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Canonical site origin, no trailing slash.
# Used for page metadata, the sitemap and structured data.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin user, created by `npm run seed`. Change before going live.
PAYLOAD_ADMIN_EMAIL=admin@a2sestates.local
PAYLOAD_ADMIN_PASSWORD=a2s-change-me

# ---------------------------------------------------------------------------
# Media storage (production only).
#
# Leave both blank locally: uploads go to ./media on disk.
# On any host with a temporary filesystem (Vercel, Cloud Run, containers) set
# ONE of the options below, otherwise uploaded images vanish on each deploy.
# ---------------------------------------------------------------------------

# Option A - Vercel Blob (simplest on Vercel; the token is added for you when
# you create a Blob store in the Vercel dashboard).
# BLOB_READ_WRITE_TOKEN=

# Option B - Any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean
# Spaces, MinIO). Set S3_FORCE_PATH_STYLE=true for R2 and MinIO.
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Automated blog (optional).
#
# Leave GEMINI_API_KEY unset to disable automatic publishing entirely.
# ---------------------------------------------------------------------------

# Google AI Studio API key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Model IDs. Change these if Google renames or retires a model; no code change
# is needed. The image model must be one that can return images.
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Shared secret protecting /api/cron/publish-post. Generate with:
#   openssl rand -hex 32
# CRON_SECRET=

# Set to true to save generated articles as DRAFTS for review instead of
# publishing them straight to the live site.
# BLOG_AUTOMATION_REVIEW_MODE=false
