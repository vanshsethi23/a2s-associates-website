# Database connection string. SQLite locally; Postgres in production (see README).
DATABASE_URL=file:./a2s.db

# Long random string used to sign auth tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Canonical site origin (no trailing slash). Used for metadata, sitemap, JSON-LD.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# First admin user, created by `npm run seed`.
PAYLOAD_ADMIN_EMAIL=admin@a2sestates.local
PAYLOAD_ADMIN_PASSWORD=a2s-change-me
